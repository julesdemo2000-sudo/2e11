# Copy to .env.local and fill in to enable the contact form to actually send
# email via Resend. Without these, /api/contact still accepts and logs
# submissions (so the form works end-to-end in dev) but delivers nothing.
RESEND_API_KEY=
CONTACT_TO=hello@2e11.com

# Used to build absolute URLs for metadata/OG tags. Defaults to
# https://2e11.com if unset.
NEXT_PUBLIC_SITE_URL=https://2e11.com
